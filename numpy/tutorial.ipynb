    "# NumPy Practice\n",
    "\n",
    "This notebook contains examples of NumPy array creation and basic operations."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "\n",
    "arr = np.array([2, 3, 4, 5, 6, 78])\n",
    "print(arr)\n",
    "\n",
    "filled = np.empty_like(arr)\n",
    "filled.fill(10)\n",
    "print(filled)\n",
    "\n",
    "matrix = np.arange(1, 13).reshape(3, 4)\n",
    "print(matrix)\n"
   ]
  }
